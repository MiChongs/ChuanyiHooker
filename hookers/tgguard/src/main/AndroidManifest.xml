<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        这个 hooker 的目标就是全部认得出来的 TG 客户端。

        跟别的 hooker 一样，包可见性要在这里声明一遍：API 30+ 上 getPackageInfo 会被
        过滤，模块界面否则会把装着的客户端显示成「未安装」—— 而拦截页恰好是用户排查
        「为什么模块说我没激活」的地方，显示错了会把人引到完全错误的方向。

        与 src/main/resources/META-INF/xposed/scope.list 以及 TelegramClients.PACKAGES
        保持一致，三处由 :checkHookerScope 在构建期比对。
    -->
    <queries>
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.web" />
        <package android:name="org.telegram.messenger.beta" />
        <package android:name="org.telegram.android" />
        <package android:name="org.telegram.group" />
        <package android:name="org.telegram.plus" />
        <package android:name="nekox.messenger" />
        <package android:name="tw.nekomimi.nekogram" />
        <package android:name="xyz.nextalone.nagram" />
        <package android:name="nu.gpu.nagram" />
        <package android:name="fork.risin42.nagramx" />
        <package android:name="top.qwq2333.nullgram" />
        <package android:name="it.owlgram.android" />
        <package android:name="it.octogram.android" />
        <package android:name="uz.unnarsx.cherrygram" />
        <package android:name="uz.unnarsx.cherrygram.beta" />
        <package android:name="com.exteragram.messenger" />
        <package android:name="com.exteragram.messenger.beta" />
        <package android:name="com.radolyn.ayugram" />
        <package android:name="org.monogram" />
        <package android:name="ua.itaysonlab.catogram" />
        <package android:name="ua.itaysonlab.messenger" />
        <package android:name="org.telegram.mdgram" />
        <package android:name="app.nicegram" />
        <package android:name="com.iMe.android" />
        <package android:name="org.vidogram.messenger" />
        <package android:name="org.telegram.BifToGram" />
        <package android:name="ir.ilmili.telegraph" />
        <package android:name="com.hanista.mobogram" />
        <package android:name="org.mobogram.messenger" />
        <package android:name="ir.persianfox.messenger" />
        <package android:name="com.wtelegram.messenger" />
    </queries>

</manifest>

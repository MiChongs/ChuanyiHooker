# 复制成 keystore.properties（同目录）后填好，即可对 debug / release 一起签名。
# keystore.properties 与 *.jks 都在 .gitignore 里，不要提交。
#
# 生成一把新钥匙（JKS，标准 Java KeyStore；本项目不用 PKCS12）：
#
#   keytool -genkeypair \
#     -keystore keystore/chuanyi-tech.jks \
#     -storetype JKS \
#     -alias chuanyi \
#     -keyalg RSA -keysize 4096 -sigalg SHA256withRSA \
#     -validity 10000 \
#     -dname "CN=Chuanyi Tech, O=Chuanyi Tech, C=CN" \
#     -storepass <口令> -keypass <口令>
#
# keytool 会提示 JKS 格式的加密算法已过时、建议迁移 PKCS12 —— 本项目明确使用
# 标准 JKS，这条警告可以忽略；apksigner 与 AGP 对两种格式一视同仁。
#
# 查看指纹：
#   keytool -list -v -keystore keystore/chuanyi-tech.jks
#
# CI 上可以不放这个文件，改用环境变量（优先级高于本文件）：
#   CHUANYI_KEYSTORE / CHUANYI_KEYSTORE_PASSWORD / CHUANYI_KEY_ALIAS / CHUANYI_KEY_PASSWORD

# 相对路径按仓库根目录解析；也可以写绝对路径，把私钥放到仓库外面。
storeFile=keystore/chuanyi-tech.jks
storePassword=
keyAlias=chuanyi
keyPassword=

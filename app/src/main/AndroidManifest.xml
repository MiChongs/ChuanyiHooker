<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        miuix-blur 的 manifest 硬写 minSdkVersion=33，因为它整套效果都建立在
        RuntimeShader 上，而那是 API 33 才有的。模块本身要覆盖 Android 9+，
        不能为了毛玻璃把三个大版本的用户砍掉，所以这里覆盖掉它的下限，改由
        运行时的 isRuntimeShaderSupported() 门控（官方文档给的就是这个做法）。
        API 28-32 上所有 blur 代码路径都不会被执行，退化成不透明背景。
    -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <!--
        Package visibility is contributed by each hooker module's own manifest
        and merged in here, so a new hooker brings its <queries> entry with it
        exactly like it brings its META-INF/xposed/scope.list. Nothing to
        maintain by hand at this level.

        Those <queries> entries cover looking up a *known* package. They cannot
        cover HookOption.AppList, which asks the user to pick from whatever is
        installed — the set is not known ahead of time, and getInstalledApplications
        returns only the visible slice without this permission, so the picker would
        show a near-empty list. QUERY_ALL_PACKAGES is the only API that answers it.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!--
        MIUI / HyperOS / ColorOS / OneUI gate the installed-app list behind an
        OEM runtime permission that has no AOSP equivalent, and deny it silently:
        getPackageInfo throws NameNotFoundException for an app that is installed.
        XXPermissions models it as GetInstalledAppsPermission and reports it as
        already granted on ROMs that do not implement it, so the request is a
        no-op on stock. This is the only runtime permission the module needs.
    -->
    <uses-permission android:name="com.android.permission.GET_INSTALLED_APPS" />

    <!--
        激活稽核作业要在重启后继续排期（JobInfo.setPersisted）。这个权限只是让
        JobScheduler 保留作业记录，不会给本应用任何开机自启的能力。
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        forceQueryable：让本应用对所有应用可见。

        不是为了方便，是激活校验那条链路的硬前提。TG 客户端进程里的探测算出令牌后
        要广播回这里落盘（它自己写不了框架配置，只读），而 Android 11+ 的包可见性
        会把**显式**广播也一并过滤掉 —— 目标 App 的清单不归我们管，不可能让它去声明
        <queries> 指向本模块。少了这一行，广播会被系统静默丢弃：探测成功、日志正常、
        令牌就是到不了，界面一直显示未激活。

        这个属性禁止用于应用商店分发的应用，本模块是自分发的，正是它的适用场景。
    -->
    <application
        android:allowBackup="false"
        android:forceQueryable="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:description="@string/xposed_description"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChuanyiHooker"
        tools:targetApi="34">

        <!--
            激活令牌的落盘入口，由 :hookers:tgguard 在 TG 客户端进程里发过来。

            导出但**不带 intent-filter**：发送方用的是显式组件名，不需要隐式匹配，
            少一个 filter 就少一份被随手 resolve 到的可能。导出本身是安全的 ——
            令牌带 MAC，接收器在写之前先验，伪造的进不来，见 ActivationReceiver。
        -->
        <receiver
            android:name=".data.ActivationReceiver"
            android:exported="true" />

        <!--
            日志回传的落点，由被注入的进程通过 core 里的 LogRelay 发过来。

            同样导出、同样不带 intent-filter（发送方用显式组件名）。导出是必须的 ——
            发送方是目标应用的 uid，而目标应用不可能持有本模块的签名权限，所以
            android:permission 这条路在这里根本不成立。

            于是任何应用都能往这里塞几行假日志。可以接受：收进来的东西只会被显示，
            不参与任何判定、不写配置、不被执行。要紧的那条链路（激活令牌）在上面那个
            接收器，每一条都验 MAC。详见 LogReceiver 的类注释。
        -->
        <receiver
            android:name=".data.LogReceiver"
            android:exported="true" />

        <!--
            每天一次的激活稽核。补的是「用户在 LSPosed 里取消了作用域之后再也不打开
            模块界面」这条路径 —— 那种情况下前台稽核永远不会跑。
            BIND_JOB_SERVICE 是系统要求的，缺了 JobScheduler 会拒绝排期。
        -->
        <service
            android:name=".data.ActivationJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Legacy Xposed discovery keys. libxposed 102 reads
            META-INF/xposed/module.prop instead, but some managers still list
            modules by these, and they cost nothing.
        -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposedminversion"
            android:value="102" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />

        <!--
            io.github.libxposed.service contributes its XposedProvider through
            manifest merging; do not declare it here as well.
        -->
    </application>

</manifest>

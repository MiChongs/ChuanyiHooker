<?xml version="1.0" encoding="utf-8"?>
<!--
    自适应图标的背景层。

    从 <shape> 换成矢量：一是要铺一层很淡的对角渐变（纯色在大图标下显得发死），
    二是背景层会被启动器做视差平移，矢量在任何缩放下都不会糊。

    渐变幅度刻意压得很小（#232A3B -> #151922）—— 背景是衬托，反差一大就会跟前景
    的蓝色抢注意力。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="108"
                android:endY="108"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="#FF232A3B"
                    android:offset="0" />
                <item
                    android:color="#FF151922"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
